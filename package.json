{
  "name": "@dsh-prism/dsh-orchestrator",
  "description": "Coordinate Prism conversations, project planners and task executors across workspaces.",
  "version": "0.2.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js"
    },
    "./provider": {
      "types": "./dist/provider.d.ts",
      "import": "./dist/provider.js"
    },
    "./model-settings": {
      "types": "./dist/model-settings.d.ts",
      "import": "./dist/model-settings.js"
    },
    "./policy": {
      "types": "./dist/policy.d.ts",
      "import": "./dist/policy.js"
    },
    "./host": {
      "types": "./dist/host.d.ts",
      "import": "./dist/host.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "dist/",
    "!dist/*.test.*",
    "!dist/*.tsbuildinfo",
    "!dist/*probe.*",
    "locale/*.json",
    "icon.svg",
    "README.zh_CN.md",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": ">=24.0.0",
    "dsh": "0.2.3-alpha.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.2.0-alpha.1",
    "@deepseek-ai/dsh-agent": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-agent-default-model": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-home-paths": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-llm": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-session-persistence": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-session-projection-cache": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-session-query": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-session-title": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-subagent": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-tool-executor-native": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-workspace": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-tools": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-settings": "0.2.3-alpha.2",
    "@deepseek-ai/schemastery": "3.20.0-alpha.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.3-alpha.2",
    "@dsh-prism/dsh-workspace-registry": "^0.1.2",
    "@deepseek-ai/dsh-agent-preset": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-tool-fs": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-tool-fs-search": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-tool-bash": "0.2.3-alpha.2"
  },
  "scripts": {
    "build": "tsc -b tsconfig.release.json",
    "test": "node --test test/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsh-plugins/dsh-orchestrator.git"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.2.3-alpha.2",
    "@types/node": "24.10.1",
    "typescript": "6.0.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
