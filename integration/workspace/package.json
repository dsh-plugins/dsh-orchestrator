{
  "name": "@dsh-prism/dsh-prism",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "棱镜 · DSH 三层分布式会话架构",
  "engines": {
    "node": ">=24.9.0"
  },
  "workspaces": [
    "dsh-workspace-registry",
    "dsh-orchestrator",
    "dsh-mesh-node",
    "dsh-concierge-ui",
    "dsh-im-gateway"
  ],
  "scripts": {
    "build": "tsc -b && npm run bundle --workspace=@dsh-prism/dsh-concierge-ui",
    "test": "npm run build && node scripts/test.mjs",
    "start": "node scripts/prism.mjs",
    "im": "node dsh-im-gateway/scripts/prism-im.mjs"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.2.3-alpha.2"
  }
}
